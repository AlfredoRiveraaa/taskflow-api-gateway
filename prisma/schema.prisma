generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Enumeraciones
enum ProjectRole {
  OWNER
  ADMIN
  MIEMBRO
}

enum ProjectState {
  ACTIVO
  ARCHIVADO
  COMPLETADO
}

enum TaskPriority {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

// 2. Entidades Principales
model User {
  id               String          @id @default(uuid())
  nombre           String
  correo           String          @unique
  passwordHash     String
  fotoPerfil       String?         // El '?' significa que es opcional
  googleId         String?
  creadoEn         DateTime        @default(now())
  
  // Relaciones inversas (requeridas por Prisma)
  proyectosCreados Project[]       @relation("ProyectosCreados")
  tareasAsignadas  Task[]          @relation("TareasAsignadas")
  tareasCreadas    Task[]          @relation("TareasCreadas")
  proyectos        ProjectMember[]
  comentarios      Comment[]
  adjuntos         Attachment[]
}

model Project {
  id          String          @id @default(uuid())
  nombre      String
  descripcion String?
  fechaInicio DateTime?
  fechaFin    DateTime?
  estado      ProjectState    @default(ACTIVO)
  color       String?
  creadoPorId String
  
  // Relaciones
  creadoPor   User            @relation("ProyectosCreados", fields: [creadoPorId], references: [id])
  sprints     Sprint[]
  tareas      Task[]
  miembros    ProjectMember[]
}

model Sprint {
  id          String    @id @default(uuid())
  proyectoId  String
  nombre      String
  objetivo    String?
  fechaInicio DateTime?
  fechaFin    DateTime?
  estado      String    @default("Planificado")
  
  // Relaciones
  proyecto    Project   @relation(fields: [proyectoId], references: [id])
  tareas      Task[]
}

model Task {
  id              String       @id @default(uuid())
  proyectoId      String
  sprintId        String?      // Opcional, puede estar en el Backlog
  titulo          String
  descripcion     String?
  estado          String       @default("Backlog")
  prioridad       TaskPriority @default(MEDIA)
  asignadoAId     String?
  creadoPorId     String
  fechaLimite     DateTime?
  estimacionHoras Int?
  columna         String       @default("Backlog")
  orden           Int          @default(0)
  
  // Relaciones
  proyecto        Project      @relation(fields: [proyectoId], references: [id])
  sprint          Sprint?      @relation(fields: [sprintId], references: [id])
  asignadoA       User?        @relation("TareasAsignadas", fields: [asignadoAId], references: [id])
  creadoPor       User         @relation("TareasCreadas", fields: [creadoPorId], references: [id])
  subtareas       Subtask[]
  comentarios     Comment[]
  etiquetas       TaskTag[]
  adjuntos        Attachment[]
}

// 3. Entidades Secundarias e Intermedias
model ProjectMember {
  proyectoId String
  userId     String
  rol        ProjectRole @default(MIEMBRO)
  
  proyecto   Project     @relation(fields: [proyectoId], references: [id])
  user       User        @relation(fields: [userId], references: [id])

  @@id([proyectoId, userId]) // Llave primaria compuesta
}

model Subtask {
  id         String  @id @default(uuid())
  taskId     String
  titulo     String
  completada Boolean @default(false)
  
  tarea      Task    @relation(fields: [taskId], references: [id])
}

model Comment {
  id       String   @id @default(uuid())
  taskId   String
  autorId  String
  texto    String
  creadoEn DateTime @default(now())
  
  tarea    Task     @relation(fields: [taskId], references: [id])
  autor    User     @relation(fields: [autorId], references: [id])
}

model Tag {
  id     String    @id @default(uuid())
  nombre String
  color  String
  
  tareas TaskTag[]
}

model TaskTag {
  taskId String
  tagId  String
  
  tarea  Task   @relation(fields: [taskId], references: [id])
  etiqueta Tag  @relation(fields: [tagId], references: [id])

  @@id([taskId, tagId])
}

model Attachment {
  id        String @id @default(uuid())
  taskId    String
  url       String
  nombre    String
  tipo      String
  subidoPorId String
  
  tarea     Task   @relation(fields: [taskId], references: [id])
  subidoPor User   @relation(fields: [subidoPorId], references: [id])
}